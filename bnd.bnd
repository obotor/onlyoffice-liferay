Bundle-Name: ONLYOFFICE Liferay Docs
Bundle-SymbolicName: com.onlyoffice.liferay-docs
Bundle-Version: 3.0.1

Import-Package: \
    !jdk.net,\
    !org.brotli.dec,\
    !org.conscrypt,\
    !org.slf4j.impl,\
    !org.glassfish.hk2.osgiresourcelocator,\
    !com.liferay.portal.kernel.resource.bundle,\
    *

-consumer-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}
-contract: JavaPortlet,JavaServlet
-jsp: *.jsp,*.jspf,*.jspx
-metatype: *
-plugin.jsp: com.liferay.ant.bnd.jsp.JspAnalyzerPlugin
-plugin.metatype: com.liferay.ant.bnd.metatype.MetatypePlugin
-plugin.resourcebundle: com.liferay.ant.bnd.resource.bundle.ResourceBundleLoaderAnalyzerPlugin
-plugin.sass: com.liferay.ant.bnd.sass.SassAnalyzerPlugin
-provider-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}
-sass: *

#-includeresource: lib=target/lib/;lib:=true

-includeresource: \
    @jackson-databind-*.jar,\
    @jackson-jaxrs-json-provider-*.jar,\
    @jackson-core-*.jar,\
    @jackson-annotations-*.jar

-exportcontents: \
    com.fasterxml.jackson.databind.*,\
    com.fasterxml.jackson.jaxrs.json.*

Bundle-ClassPath: .,jackson-databind-2.17.1.jar,jackson-jaxrs-json-provider-2.17.1.jar

-fixupmessages "Classes found in the wrong directory"; restrict:=error; is:=warning
