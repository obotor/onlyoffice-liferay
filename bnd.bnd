Bundle-Name: ONLYOFFICE Liferay Docs
Bundle-SymbolicName: com.onlyoffice.liferay-docs
Bundle-Version: 3.0.1

Import-Package: \
    !jdk.net,\
    !org.brotli.dec,\
    !org.conscrypt,\
    !org.slf4j.impl,\
    !org.glassfish.hk2.osgiresourcelocator,\
    !com.fasterxml.jackson.*,\
    !com.liferay.portal.kernel.resource.bundle,\
    *

-consumer-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}
-contract: JavaPortlet,JavaServlet
-jsp: *.jsp,*.jspf,*.jspx
-metatype: *
-plugin.jsp: com.liferay.ant.bnd.jsp.JspAnalyzerPlugin
-plugin.metatype: com.liferay.ant.bnd.metatype.MetatypePlugin
-plugin.resourcebundle: com.liferay.ant.bnd.resource.bundle.ResourceBundleLoaderAnalyzerPlugin
-plugin.sass: com.liferay.ant.bnd.sass.SassAnalyzerPlugin
-provider-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}
-sass: *

#-includeresource: lib=target/lib/;lib:=true

-includeresource: \
    @build/tmp/lib/docs-integration-sdk-1.3.0.jar,\
    @build/tmp/lib/httpclient5-5.4.jar,\
    @build/tmp/lib/httpcore5-5.3.jar,\
    @build/tmp/lib/httpcore5-h2-5.3.jar,\
    @build/tmp/lib/java-jwt-4.0.0.jar,\
    @build/tmp/lib/jackson-databind-2.17.1.jar,\
    @build/tmp/lib/jackson-core-2.17.1.jar,\
    @build/tmp/lib/jackson-annotations-2.17.1.jar,\
    @build/tmp/lib/jackson-dataformat-properties-2.17.1.jar,\
    @build/tmp/lib/jackson-jaxrs-json-provider-2.17.1.jar

Bundle-ClassPath: .,\
    docs-integration-sdk-1.3.0.jar,\
    httpclient5-5.4.jar,\
    httpcore5-5.3.jar,\
    httpcore5-h2-5.3.jar,\
    jackson-databind-2.17.1.jar,\
    jackson-core-2.17.1.jar,\
    jackson-annotations-2.17.1.jar,\
    jackson-dataformat-properties-2.17.1.jar,\
    jackson-jaxrs-json-provider-2.17.1.jar,\
    java-jwt-4.0.0.jar

-fixupmessages "Classes found in the wrong directory"; restrict:=error; is:=warning
